  ],
  "item": [
    {
      "name": "1. GET - Todos los Productos",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        },
        "description": "Obtiene la lista completa de productos clínicos desde la API."
      }
    },
    {
      "name": "2. GET - Producto por ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "1"]
        },
        "description": "Obtiene los detalles del producto con ID 1."
      }
    },
    {
      "name": "3. POST - Registrar Nuevo Producto (CREATE)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"CLI-PRD-009\",\n  \"nombre\": \"Nebulizador Ultrasónico Portátil\",\n  \"categoria\": \"Equipos de Monitoreo\",\n  \"laboratorio\": \"Philips Respironics\",\n  \"presentacion\": \"Kit con mascarilla adulto y pediátrica\",\n  \"precio\": 149.90,\n  \"stock\": 15,\n  \"descuento\": 10,\n  \"requiereReceta\": false,\n  \"imagen\": \"https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80\",\n  \"descripcion\": \"Nebulizador silencioso de alta eficiencia para tratamientos respiratorios en casa.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        },
        "description": "Registra un nuevo producto. Asigna ID autoincremental y responde 201 Created."
      }
    },
    {
      "name": "4. PUT - Actualizar Producto (UPDATE)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"CLI-PRD-009\",\n  \"nombre\": \"Nebulizador Ultrasónico Portátil PLUS\",\n  \"categoria\": \"Equipos de Monitoreo\",\n  \"laboratorio\": \"Philips Respironics\",\n  \"presentacion\": \"Kit Pro con mascarilla y boquilla\",\n  \"precio\": 139.00,\n  \"stock\": 12,\n  \"descuento\": 15,\n  \"requiereReceta\": false,\n  \"imagen\": \"https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=800&q=80\",\n  \"descripcion\": \"Versión mejorada con batería recargable y apagado automático.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos/9",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "9"]
        },
        "description": "Actualiza los datos del producto con ID 9."
      }
    },
    {
      "name": "5. DELETE - Eliminar Producto (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [
