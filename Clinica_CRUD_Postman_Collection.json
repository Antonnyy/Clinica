        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        },
        "description": "Prueba de validación: debe responder 400 Bad Request indicando que el código es obligatorio."
      }
    },
