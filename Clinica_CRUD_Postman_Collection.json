        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos/9",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "9"]
        },
        "description": "Elimina el producto con ID 9 de la lista en memoria."
      }
    },
    {
      "name": "6. VALIDACIÓN - Código Vacío (400 Bad Request)",
